# Copy to .env and fill in. Never commit .env.
# Default provider is "mock": the whole system runs offline with no key.
LLM_PROVIDER=mock
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-plus
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=

# Embeddings: "hashing" (offline, no download) or "sentence-transformers".
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=512

# Retrieval tuning
RAG_TOP_K=4
RAG_CANDIDATE_K=12
RAG_RRF_K=60
RAG_USE_HYDE=1
RAG_USE_RERANK=1
RAG_MIN_SCORE=0.02

# Chunking: fixed | semantic | small_to_big
RAG_CHUNK_STRATEGY=semantic
RAG_CHUNK_SIZE=320
RAG_CHUNK_OVERLAP=64

RAG_CORPUS_DIR=data/corpus
